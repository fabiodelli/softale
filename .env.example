# Copia questo file in .env.local e popola i valori.
# .env.local e' in .gitignore: non deve mai essere committato.

# --- Supabase (database, auth, storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Token personale, serve solo a `npm run update-types`
SUPABASE_ACCESS_TOKEN=

# --- Stripe (abbonamenti) ---
# STRIPE_SECRET_KEY e' richiesta anche in fase di build
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=

# --- Audio Factory: generazione contenuti ---
# Claude: concept e script delle storie
ANTHROPIC_API_KEY=
# Stable Audio: musica e ambience
STABILITY_API_KEY=
# TTS alternativi / sperimentazione
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_API_KEY=
